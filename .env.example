# ==========================================================================
# wechat-memory-agent configuration
# Copy to .env and fill in.  All variables are optional at first run.
# ==========================================================================

# --- Data location (defaults to ~/wechat-memory-agent-data) ---------------
# WMA_DATA_HOME=C:/Users/asta1/wechat-memory-agent-data

# --- LLM API (OpenAI-compatible, used to generate file metadata) ----------
WMA_LLM_BASE_URL=https://api.example.com/v1
WMA_LLM_API_KEY=your-key
WMA_LLM_MODEL=your-model
# Optional: a different model for vision/image description
# WMA_LLM_VISION_MODEL=

# --- WeChat iLink (filled in by `python scripts/login.py`, or manually) ---
# WEIXIN_ACCOUNT_ID=
# WEIXIN_TOKEN=
# WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
# WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c

# --- Storage tuning --------------------------------------------------------
# WMA_BINARY_THRESHOLD_MB=10
